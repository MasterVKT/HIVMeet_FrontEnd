{
  "mcpServers": {
    "hivmeet-code-review-graph": {
      "command": "d:\\Projets\\HIVMeet\\hivmeet\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "code_review_graph",
        "serve"
      ],
      "cwd": "D:\\Projets\\HIVMeet\\hivmeet"
    },
    "code-review-graph": {
      "command": "d:\\Projets\\HIVMeet\\hivmeet\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "code_review_graph",
        "serve"
      ],
      "cwd": "D:\\Projets\\HIVMeet\\hivmeet"
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .gemini/hooks/crg-session-start.sh",
            "name": "code-review-graph status",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "type": "command",
            "command": "bash .gemini/hooks/crg-update.sh",
            "name": "code-review-graph update",
            "timeout": 30000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .gemini/hooks/task-router-gate.sh",
            "name": "task-router gate",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .gemini/hooks/double-check-completion.sh",
            "name": "double-check completion",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
