{
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compile.nullAnalysis.mode": "automatic",
    "codex.localEnvironmentConfigPath": "${workspaceFolder}/.codex",
    "chat.agent.sandbox.advanced.runtime": {
        "enableWeakerNestedSandbox": false
    },
    "chat.utilityModel": "ollama-models/deepseek-v4-flash:cloud",
    "chat.agent.maxRequests": 300,
    "chat.hookFilesLocations": {
        ".vscode/hooks": true,
        ".github/hooks": false,
        ".claude/settings.json": false,
        ".claude/settings.local.json": false
    },
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx8G -Xms100m -Xlog:disable",
    "ollamaCloudCopilot.streamIdleTimeoutSeconds": 300
}
