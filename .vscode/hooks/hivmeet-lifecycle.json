{
  "version": 1,
  "hooks": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "python .agents/hooks/lifecycle_hook.py --event prompt --scope frontend --host vscode --map .agents/project-map.json",
        "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .agents/hooks/invoke-agent-hook.ps1 -Event prompt -Scope frontend -HostName vscode",
        "cwd": ".",
        "timeoutSec": 30
      }
    ]
  }
}
